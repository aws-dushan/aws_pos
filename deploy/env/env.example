# One POS: environment (live or test). The same file is used on both servers: /opt/aws/onepos/<env>/.env, mode 600.
# deploy/first-install.sh writes it with fresh random passwords; edit by hand only to move or resize (deploy/README.md).

ONEPOS_ENV=live                # live | test
ONEPOS_VERSION=                # set by `onepos deploy`: the release running now
BASE_PATH=/onepos              # /onepos | /onepos-test (must match the web image, built in by deploy/release.sh)
PUBLIC_URL=https://ralsnahashho.dyndns.org:1000/onepos
TZ=Asia/Dubai

# Database (data server). DB_BIND = the address the database listens on, DB_HOST = the address the application server uses.
# One server for both: DB_BIND=127.0.0.1 is NOT reachable from containers; use the host's internal address instead.
DB_HOST=172.30.0.20
DB_BIND=172.30.0.20
DB_PORT=5444                   # live 5444, test 5445 (SFA 5432/5433/6432, AWS One 5442/5443)
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
PINS_SECRET=                   # signs till PINs; never change on a running environment
SEED_ADMIN_USERNAME=ERP_Admin    # first start only: the first administrator (signs in as erp_admin; case does not matter)
SEED_ADMIN_PASSWORD=           # first start only; must be changed at the first sign-in

# Where everything lives (one folder per environment and server; extend the volume under it to grow).
DATA_DIR=/opt/aws/onepos/live      # app server: files/ ; data server: pgdata/ + pgbackrest/
BACKUP_DIR=/opt/aws/onepos/backups/live
BACKUP_AT=02:45                # app server: dump + files (AWS One runs at 02:30)
DB_BACKUP_AT=01:45             # data server: pgBackRest, full Sundays, differential other days (AWS One 01:30)
BACKUP_KEEP_DAYS=14
OFFSITE_TARGET=admin-data@172.30.0.20:live   # rsync target (restricted key, see deploy/first-install.sh); empty = none
OFFSITE_KEY=/opt/aws/onepos/keys/offsite_ed25519

EDGE_NETWORK=aws-app_aws-app   # the shared gateway's Docker network

# Resources (raise when needed; then `onepos deploy <env> <same version>` / `onepos-db up <env>`).
API_CPUS=2
API_MEMORY=1536m
WEB_CPUS=1
WEB_MEMORY=768m
DB_CPUS=4
DB_MEMORY=4g
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
