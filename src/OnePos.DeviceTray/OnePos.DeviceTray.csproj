<Project Sdk="Microsoft.NET.Sdk">

  <!-- One POS Device tray (REQ HW-01): the icon by the clock on each till showing whether the Device Service runs, its printer,
       and updates; starts with Windows (the installer adds it). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OnePos.DeviceTray</RootNamespace>
    <AssemblyName>OnePos.DeviceTray</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
